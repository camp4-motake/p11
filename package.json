{
  "name": "p11",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm '/^dev:.*/'",
    "dev:watch": "node lib/watch.mjs",
    "dev:parcel": "parcel '.tmp/**/*.html' --dist-dir dist --no-cache",
    "build": "tsc && pnpm build:eleventy && pnpm build:parcel && pnpm build:format:html",
    "build:eleventy": "pnpm exec eleventy --config=eleventy.config.ts",
    "build:parcel": "parcel build \"./.tmp/**/*.html\" --dist-dir dist --no-cache --no-source-maps",
    "build:format:html": "pnpm dlx js-beautify@latest \"./dist/**/*.html\" --indent-size 2 --no-preserve-newlines --end-with-newline false --extra-liners \"\" --unformatted \"script,style,svg,noscript\" --replace",
    "lint": "biome lint src && stylelint 'src/**/*.css'",
    "format": "biome check --write && stylelint 'src/**/*.css' --fix",
    "clean": "rimraf dist .tmp .parcel-cache",
    "clean:cache": "rimraf .parcel-cache",
    "predev": "pnpm clean && pnpm build",
    "prebuild": "pnpm clean"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@acab/reset.css": "^0.11.0",
    "@parcel/config-default": "^2.16.4",
    "@parcel/optimizer-htmlnano": "^2.16.4",
    "@parcel/resolver-glob": "^2.16.4",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "image-size": "^2.0.2",
    "parcel": "^2.16.4",
    "parcel-namer-rewrite": "2.10.3-rc.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "sharp": "^0.33.5",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.6.0"
  },
  "@parcel/transformer-css": {
    "drafts": {
      "nesting": true,
      "customMedia": true
    }
  },
  "parcel-namer-rewrite": {
    "chain": "@parcel/namer-default",
    "hashing": "always",
    "disable": false,
    "silent": true,
    "rules": {
      "(.*).(css|js|webp|avif|png|jpe?g|gif|svg|mp4|json)": "assets/$1{.hash}.$2"
    }
  },
  "stylelint": {
    "extends": [
      "stylelint-config-recess-order"
    ],
    "rules": {
      "no-descending-specificity": null
    }
  },
  "browserslist": [
    "> 0.5% in JP and last 2 years and not dead"
  ],
  "packageManager": "pnpm@10.29.2",
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "^24.13.0",
        "onFail": "download"
      }
    ]
  }
}
